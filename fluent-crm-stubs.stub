         * - a string
         *
         * BUT NOT a SplTempFileObject
         *
         * <code>
         *<?php
         * $csv = new Reader::createFromPath('/path/to/file.csv', 'a+');
         * $csv = new Reader::createFromPath(new SplFileInfo('/path/to/file.csv'));
