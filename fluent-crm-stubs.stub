         *
         * @param string $str     the string
         * @param string $newline the newline character
         *
         * @return static
         */
        public static function createFromString($str, $newline = "\n")
        {
        }
        /**
         * Creates a {@link AbstractCsv} instance from another {@link AbstractCsv} object
